{
  "permissions": {
    "allow": [
      "Bash(date)",
      "Bash(date *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git checkout -- *)",
      "Bash(git ls-remote *)",
      "Bash(python -m pytest *)",
      "Bash(python -m *)",
      "Bash(python -c *)",
      "Bash(python - *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx next build*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(cd /home/user/agentic_trading_system)",
      "Bash(cd /home/user/agentic_trading_system/*)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(until *)",
      "Bash(for *)",
      "Bash(while *)",
      "Bash(sleep *)",
      "Grep",
      "Glob",
      "Read"
    ],
    "deny": [
      "Bash(git remote -v*)",
      "Bash(git remote --verbose*)",
      "Bash(git config --list*)",
      "Bash(git config -l*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat /home/user/agentic_trading_system/.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(grep .env*)",
      "Bash(sed .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/tuning.env)",
      "Read(**/*.pem)",
      "Read(**/*service-account*.json)",
      "Read(**/.git-credentials)",
      "Read(./research/data/**)",
      "Read(./dashboard/node_modules/**)",
      "Read(./dashboard/.next/**)",
      "Read(./ops/results/archivio_*/**)"
    ],
    "ask": [
      "Edit(./bot/risk/hard_limits.py)",
      "Write(./bot/risk/hard_limits.py)",
      "Edit(./bot/risk/circuit_breakers.py)",
      "Write(./bot/risk/circuit_breakers.py)",
      "Edit(./bot/risk/kill_switch.py)",
      "Write(./bot/risk/kill_switch.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/research/src/guardiano.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/segreti.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"PROMEMORIA DEL PROPRIETARIO: rispondi SEMPRE e SOLO in italiano, in ogni messaggio (anche quelli brevi di stato, anche dopo un riassunto o una ripresa, anche se file e strumenti sono in inglese). Italiano semplice, niente sigle.\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/controllo_lingua.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
