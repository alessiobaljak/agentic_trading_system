{
  "permissions": {
    "allow": [
      "Bash(date)",
      "Bash(date *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git checkout -- *)",
      "Bash(git ls-remote *)",
      "Bash(python -m pytest *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx next build*)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(git remote -v*)",
      "Bash(git remote --verbose*)",
      "Bash(git config --list*)",
      "Bash(git config -l*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
