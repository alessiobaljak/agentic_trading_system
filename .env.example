# =====================================================================
# Template variabili d'ambiente — COPIA in `.env` e compila.
# NON committare mai il file .env reale. Su GitHub usa i Secrets,
# su Vercel le env vars del progetto, sulla VPS questo .env.
# =====================================================================

# --- Modalità di esecuzione ---
# DRY_RUN=true  => paper trading (NESSUN ordine reale su Binance). DEFAULT consigliato.
# DRY_RUN=false => live trading con denaro reale. Attivare solo dopo settimane di paper ok.
DRY_RUN=true

# --- Binance Futures ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = testnet futures (https://testnet.binancefuture.com), false = mainnet
BINANCE_TESTNET=true

# --- Anthropic Claude (orchestratore + classificazione news) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Data agents ---
LUNARCRUSH_API_KEY=
COINGLASS_API_KEY=
NEWSAPI_KEY=

# --- Firebase (service account JSON come stringa su una riga) ---
FIREBASE_SERVICE_ACCOUNT=
# URL del Realtime Database, es: https://<project>-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_RTDB_URL=

# --- Telegram alert ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================================
# Dashboard (Vercel) — variabili client, prefisso NEXT_PUBLIC_
# Queste sono pubbliche per design (config client Firebase).
# =====================================================================
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
